{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev:convex": {
            "persistent": true,
            "cache": false
        },
        "dev:next": {
            "persistent": true,
            "cache": false
        }
    },
    "globalEnv": [
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "NEXT_PUBLIC_CONVEX_URL",
        "CLERK_JWT_ISSUER_DOMAIN"
    ]
}
